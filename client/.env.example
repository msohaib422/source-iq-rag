# =============================================================================
# SourceIQ — client configuration (optional)
# =============================================================================
# The client defaults to a relative /api base URL, which the Vite dev server
# proxies to the Express backend. You normally do NOT need any of this.
# =============================================================================

# Absolute API URL for production builds served from a different origin.
# VITE_API_URL=https://api.example.com

# Where the dev server proxies /api.
# VITE_DEV_API_URL=http://127.0.0.1:5000

# VITE_PORT=5173
# VITE_HOST=127.0.0.1