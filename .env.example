# =============================================================================
# SourceIQ — root environment
# =============================================================================
# The server reads server/.env; the client reads client/.env.
# This root file is here so `dotenv` conventions stay consistent if you prefer
# to keep a single file. Copy server/.env.example -> server/.env to get going.
# =============================================================================

# The only variables the client reads (all optional):
# VITE_API_URL=http://localhost:5000      # absolute API base URL (default: relative /api via the Vite proxy)
# VITE_DEV_API_URL=http://127.0.0.1:5000  # where the dev server proxies /api
# VITE_PORT=5173
# VITE_HOST=127.0.0.1