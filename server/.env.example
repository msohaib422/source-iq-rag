# =============================================================================
# SourceIQ — server configuration
# =============================================================================
# Copy to server/.env and fill in. Nothing here is committed (.gitignore).
# Every value below is the built-in default unless marked REQUIRED.
# =============================================================================

# ---------------------------------------------------------------- runtime ---
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------- auth ---
# REQUIRED in production. At least 16 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=sourceiq-dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=7d

# Admin-only authentication. There is no public registration: regular users
# use the app without an account, and only the admin can sign in. The single
# admin account is created automatically on first boot (when BOOTSTRAP_ADMIN=true).
# Change these before exposing the server to anyone.
BOOTSTRAP_ADMIN=true
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=12345678
ADMIN_NAME=Administrator

# -------------------------------------------------------------- datastore ---
# REQUIRED to use MongoDB Atlas. Paste your Atlas connection string here.
# Use a DEDICATED test database, e.g. mongodb+srv://user:pass@cluster.mongodb.net/sourceiq_test
# Leave blank to run against the built-in in-memory datastore (fine for local dev
# and for the automated test-suite).
MONGODB_URI=
MONGODB_DB_NAME=sourceiq

# Optional: force a driver. Leave unset to auto-select Atlas when MONGODB_URI
# is present, otherwise in-memory.
# STORE_DRIVER=atlas

# ------------------------------------------- embedding model (LOCAL ONLY) ---
# BAAI/bge-small-en-v1.5 is mandatory and runs entirely on this machine via
# Transformers.js + ONNX Runtime. No hosted embedding API is used.
EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
# bge-small-en-v1.5 publishes only onnx/model.onnx (fp32). No quantised variant exists.
EMBEDDING_DTYPE=fp32
# Project-local cache. Weights (~128 MB) land here and are gitignored.
EMBEDDING_CACHE_DIR=./models
EMBEDDING_MAX_TOKENS=512
EMBEDDING_BATCH_SIZE=16
# Load weights during boot (true) or lazily on first request (false).
EMBEDDING_PRELOAD=true
# Refuse to start when the model cannot load. Keep true — there is no fallback model.
STRICT_EMBEDDINGS=true

# ---------------------------------------------------------------- chunking ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# ----------------------------------------------------------- vector search ---
# The Atlas index name must match the one created by `npm run atlas:index`.
VECTOR_INDEX_NAME=vector_index
VECTOR_NUM_CANDIDATES=150
VECTOR_LIMIT=8

# ------------------------------------------------------------------- LLM ----
# One of: mock | groq | mistral | openrouter | openai | gemini
#   mock       — deterministic offline extractive answering, no key needed (default)
#   groq       — https://api.groq.com/openai/v1
#   mistral    — https://api.mistral.ai/v1
#   openrouter — https://openrouter.ai/api/v1
#   openai     — https://api.openai.com/v1
#   gemini     — Google AI Studio
LLM_PROVIDER=mock

# Generic key used for the selected provider. You can instead use the
# provider-specific variable below and leave LLM_API_KEY blank.
LLM_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Override the provider's default model.
# LLM_MODEL=llama-3.3-70b-versatile
# Point at any OpenAI-compatible gateway (Ollama, vLLM, LiteLLM, Together…).
# LLM_BASE_URL=http://127.0.0.1:11434/v1

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900

# ---------------------------------------------------------------- uploads ---
MAX_UPLOAD_MB=25
UPLOAD_DIR=./uploads

# =============================================================================
# Atlas Admin API — only needed for `npm run atlas:index`
# Create under Atlas → Project Settings → API Keys.
# =============================================================================
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_GROUP_ID=
ATLAS_CLUSTER_NAME=